# =====================================
# Python and general build artifacts
# =====================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
dist/
build/
.eggs/

# =====================================
# Jupyter Notebooks
# =====================================
.ipynb_checkpoints/
*.ipynb_checkpoints
*/.ipynb_checkpoints/*

# =====================================
# Virtual Environments
# =====================================
env/
venv/
ENV/
.venv/
conda-env/
*.conda
.conda/

# =====================================
# IDE / OS metadata
# =====================================
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
.Trash-*

# =====================================
# Biomedical & large data (CRITICAL)
# Ignore only top-level data folders
# =====================================
/data/
/raw_data/
/processed_data/
*.csv
*.tsv
*.xlsx
*.h5
*.hdf5
*.pkl
*.pickle
*.npy
*.npz
*.feather
*.parquet

# =====================================
# TCGA / ORIEN data
# =====================================
/tcga_data/
/orien_data/
/clinical_data/
/expression_data/
*.gct
*.gct.gz
*.maf

# =====================================
# Model files & large binaries
# Ignore only top-level model folders
# =====================================
/models/
/checkpoints/
/saved_models/
/model_weights/
*.pth
*.pt
*.ckpt
*.pb
*.h5

# =====================================
# Results, figures, logs (keep structure)
# =====================================
results/*
!results/.gitkeep
figures/*
!figures/.gitkeep
logs/*
!logs/.gitkeep

# =====================================
# Experiment / training artifacts
# =====================================
*.log
*.tmp
*.temp
*.cache
wandb/
mlruns/
tensorboard/
.tensorboard/
job_logs/
slurm-*.out
*.err
*.out

# =====================================
# Environment / credentials
# =====================================
.env
.env.local
*.key
*.pem
config/secrets.yaml
credentials/

# =====================================
# Output files (non-source)
# =====================================
*.pdf
*.png
*.jpg
*.jpeg
*.svg
*.eps
!figures/examples/*

# =====================================
# Documentation build
# =====================================
docs/_build/
docs/_static/
docs/_templates/

# =====================================
# Testing & coverage
# =====================================
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# =====================================
# R / Miscellaneous
# =====================================
.Rhistory
.Rdata
.Rproj.user/

# =====================================
# Archives and large files
# =====================================
*.zip
*.tar
*.tar.gz
*.gz

# =====================================
# Always include key text/config files
# =====================================
!requirements.txt
!environment.yml

# =====================================
# --- Allow source code & configs ---
# Never ignore Python or YAML code in these dirs
# =====================================
!src/**/*.py
!src/**/*.ipynb
!src/**/*.yaml
!scripts/**/*.py
!scripts/**/*.ipynb
!config/**/*.yaml
