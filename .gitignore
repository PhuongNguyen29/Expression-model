# =====================================
# PYTHON & GENERAL BUILD ARTIFACTS
# =====================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
dist/
build/
.eggs/
.pytest_cache/
*.pyo
*.pyd

# =====================================
# JUPYTER NOTEBOOKS
# =====================================
.ipynb_checkpoints/
*.ipynb_checkpoints
*/.ipynb_checkpoints/*

# =====================================
# VIRTUAL ENVIRONMENTS
# =====================================
env/
venv/
ENV/
.venv/
conda-env/
*.conda
.conda/

# =====================================
# IDE / OS METADATA
# =====================================
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
.Trash-*
*.sublime-*

# =====================================
# LARGE DATA FILES (BIOMEDICAL)
# =====================================
# Exclude large expression/clinical data files
data/raw/*.csv
data/raw/*.tsv
data/raw/*.xlsx
data/raw/*.gz
data/raw/*.zip

data/processed/*.csv
data/processed/*.tsv
data/processed/*.pkl
data/processed/*.pickle
data/processed/*.h5
data/processed/*.hdf5
data/processed/*.feather
data/processed/*.parquet

# Keep small reference files
!data/raw/consensus_genes_308.txt
!data/raw/README.md
!data/processed/README.md
!data/*/README.md

# Exclude any accidentally created data directories
/raw_data/
/processed_data/
/tcga_data/
/orien_data/
/clinical_data/
/expression_data/

# =====================================
# MODEL CHECKPOINTS & LARGE BINARIES
# =====================================
# Trained model files (large)
*.pth
*.pt
*.ckpt
*.pb
*.h5
*.hdf5

# Numpy arrays & pickles (potentially large)
*.npy
*.npz
*.pkl
*.pickle

# Exclude these even in FINAL_chapter3
results/FINAL_chapter3/**/*.pth
results/FINAL_chapter3/**/*.pkl
results/FINAL_chapter3/**/*.pt
results/FINAL_chapter3/**/*.h5

# But keep the directory structure
!results/FINAL_chapter3/
!results/FINAL_chapter3/**/
!results/FINAL_chapter3/**/.gitkeep

# =====================================
# RESULTS & OUTPUTS (HPC-ONLY)
# =====================================
# Exclude all results except FINAL_chapter3
results/*
!results/.gitkeep
!results/FINAL_chapter3/

# Within FINAL_chapter3, keep metadata but exclude models
!results/FINAL_chapter3/**/*.json
!results/FINAL_chapter3/**/*.csv
!results/FINAL_chapter3/**/*.txt
!results/FINAL_chapter3/**/README.md

# =====================================
# LOGS (HPC-ONLY)
# =====================================
logs/
*.log
*.out
*.err
!logs/.gitkeep

# SLURM/SGE job logs
slurm-*.out
job_logs/

# =====================================
# FIGURES (SELECTIVE)
# =====================================
# Exclude figures directory but keep final versions
figures/*
!figures/.gitkeep
!figures/final/
!figures/final/**

# If you want to track specific figure types in FINAL_chapter3
!results/FINAL_chapter3/**/*.png
!results/FINAL_chapter3/**/*.pdf
!results/FINAL_chapter3/**/*.svg

# =====================================
# EXPERIMENT / TRAINING ARTIFACTS
# =====================================
*.tmp
*.temp
*.cache
wandb/
mlruns/
tensorboard/
.tensorboard/

# =====================================
# BIOINFORMATICS FILE FORMATS (LARGE)
# =====================================
*.gct
*.gct.gz
*.maf
*.bed
*.bam
*.sam
*.vcf
*.vcf.gz
*.fastq
*.fastq.gz
*.fasta
*.fa

# =====================================
# ENVIRONMENT / CREDENTIALS
# =====================================
.env
.env.local
*.key
*.pem
config/secrets.yaml
credentials/

# =====================================
# TESTING & COVERAGE
# =====================================
.coverage
htmlcov/
.tox/
.nox/

# =====================================
# DOCUMENTATION BUILD
# =====================================
docs/_build/
docs/_static/
docs/_templates/

# =====================================
# R / MISCELLANEOUS
# =====================================
.Rhistory
.Rdata
.Rproj.user/

# =====================================
# BACKUPS & ORPHANED FILES
# =====================================
*.backup
*.bak
*.old
--config
--verbose

# =====================================
# ALWAYS TRACK THESE (EXPLICIT INCLUDE)
# =====================================
# These are already not excluded, but making it explicit
!requirements.txt
!environment.yml
!README.md
!LICENSE
!.gitignore

# Track all source code
!src/**/*.py
!scripts/**/*.py
!scripts/**/*.sh
!config/**/*.yaml
